    "sqltools.connections": [
      {
        "mysqlOptions": {
          "authProtocol": "default",
          "enableSsl": "Disabled"
        },
        "ssh": "Disabled",
        "previewLimit": 50,
        "server": "localhost",
        "port": 3306,
        "driver": "MySQL",
        "name": "ITQA",
        "group": "ITQA",
        "database": "qa_training",
        "username": "root",
        "password": "root123"
      }
    ],
    "workbench.colorCustomizations": {
      "activityBar.activeBackground": "#1e4d78",
      "activityBar.background": "#1e4d78",
      "activityBar.foreground": "#e8f4fc",
      "activityBar.inactiveForeground": "#e8f4fc99",
      "activityBarBadge.background": "#0ea5e9",
      "activityBarBadge.foreground": "#0f2744",
      "commandCenter.border": "#e8f4fc99",
      "sash.hoverBorder": "#1e4d78",
      "statusBar.background": "#0f2744",
      "statusBar.foreground": "#e8f4fc",
